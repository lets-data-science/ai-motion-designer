PORT=3082
# Optional. Manual editing and local exports need no API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hard maximum network attempts per UTC day, including failed calls. No auto-retries.
GEMINI_DAILY_LIMIT=5
# Optional Chrome path. Setup detects standard Chrome locations on Mac/Linux/Windows.
CHROME_PATH=
